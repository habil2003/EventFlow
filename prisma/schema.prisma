generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ENUMS
// ==========================================

enum Role {
  ADMIN
  ORGANIZER
  VENDOR
  USER
}

enum AccountStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum PaymentStatus {
  PENDING
  HELD_IN_ESCROW
  PROCESSING_PAYOUT
  COMPLETED
  DISPUTED
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum PaymentGateway {
  KHALTI
  ESEWA
}

enum PaymentType {
  TICKET_PURCHASE
  VENDOR_DEPOSIT
  VENDOR_REMAINING
}

enum VendorPaymentStatus {
  PENDING
  DEPOSIT_PAID
  FULLY_PAID
  COMPLETED
  REFUNDED
  DISPUTED
  PROCESSING_PAYOUT
}

enum RefundStatus {
  PENDING_ADMIN
  PROCESSED
  FAILED
  CANCELLED
}

enum RatingType {
  VENDOR
  EVENT
}

// ==========================================
// 2. CORE USER MANAGEMENT
// ==========================================

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(USER)
  status       AccountStatus @default(APPROVED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  emailVerified    DateTime?
  verificationToken String?   @unique
  verificationTokenExpires DateTime?
  resetPasswordToken     String?
  resetPasswordExpires   DateTime?

  organizedEvents  TicketedEvent[]   @relation("OrganizerToEvents")
  organizerProfile OrganizerProfile?
  vendorProfile    VendorProfile?
  socialEvents     UserSocialEvent[]
  ticketBookings   TicketBooking[]
  vendorBookings   VendorBooking[]
  processedPayouts Payout[] @relation("AdminPayouts")
  ticketReservations TicketReservation[]
  disputes         Dispute[]
  ratings          Rating[]
}

// ==========================================
// 3. TICKETED EVENTS MODULE
// ==========================================

model OrganizerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  businessName String
  businessType String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TicketedEvent {
  id            String   @id @default(cuid())
  title         String
  description   String?
  imageUrl      String?
  galleryImages String[]
  eventDate     DateTime
  eventTime     String
  location      String
  capacity      Int
  organizerId   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isActive      Boolean  @default(true)
  
  isCompleted   Boolean  @default(false)
  completedAt   DateTime?

  organizer   User            @relation("OrganizerToEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  ticketTiers TicketTier[]
  bookings    TicketBooking[]
  reservations TicketReservation[]
  ratings Rating[] @relation("eventRatings")
}

model TicketTier {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int
  soldCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event          TicketedEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketBookings TicketBooking[]
  reservations TicketReservation[]
}

model TicketBooking {
  id            String        @id @default(cuid())
  ticketNumber  String
  userId        String
  eventId       String
  tierId        String
  quantity      Int           @default(1)
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)
  gateway       String
  transactionId String?       @unique
  qrCodeHash    String?       @unique
  checkedIn     Boolean       @default(false)
  checkedInAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  paymentIntentId String?
  escrowReleased  Boolean      @default(false)
  amountReleasedAt DateTime?

  payouts Payout[]

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  event               TicketedEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tier                TicketTier           @relation(fields: [tierId], references: [id], onDelete: Cascade)
  paymentTransactions PaymentTransaction[]
  refunds             Refund[]
  ratings Rating[] @relation("ticketRatings")
}

model TicketReservation {
  id        String   @id @default(cuid())
  eventId   String
  tierId    String
  userId    String
  quantity  Int
  expiresAt DateTime
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event TicketedEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tier  TicketTier    @relation(fields: [tierId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([tierId])
  @@index([userId])
  @@index([expiresAt])
  @@index([status])
}

// ==========================================
// 3.5 SERVICE TYPES (admin-managed vendor categories)
// ==========================================

model ServiceType {
  id        String   @id
  label     String
  emoji     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ==========================================
// 4. SOCIAL EVENTS & VENDOR MODULE
// ==========================================

model VendorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  businessName  String
  serviceType   String
  location      String
  description   String?
  imageUrl      String?
  galleryImages String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  servicePackages ServicePackage[]
  vendorBookings  VendorBooking[]
  payouts         Payout[]
  unavailableDates VendorUnavailableDate[]
  ratings Rating[] @relation("vendorRatings")
}

model ServicePackage {
  id            String   @id @default(cuid())
  vendorId      String
  name          String
  price         Decimal  @db.Decimal(10, 2)
  description   String
  imageUrl      String?
  galleryImages String[]
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pricingType    String  @default("fixed")
  minGuests      Int?
  maxGuests      Int?
  serviceDetails Json?
  status         String  @default("draft")

  vendor         VendorProfile   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  packageAddOns  PackageAddOn[]
  vendorBookings VendorBooking[]
}

model PackageAddOn {
  id         String   @id @default(cuid())
  packageId  String
  name       String
  extraPrice Decimal  @db.Decimal(10, 2)
  isOptional Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pricingType String @default("fixed")

  servicePackage ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  bookingAddOns  BookingAddOn[]
}

model UserSocialEvent {
  id         String   @id @default(cuid())
  userId     String
  title      String
  eventDate  DateTime
  guestCount Int
  status     String   @default("PLANNING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorBookings VendorBooking[]
}

model VendorBooking {
  id                String              @id @default(cuid())
  userSocialEventId String
  userId            String
  vendorId          String
  packageId         String
  totalAmount       Decimal             @db.Decimal(10, 2)
  bookingStatus     BookingStatus       @default(PENDING)
  paymentStatus     PaymentStatus       @default(PENDING)
  gateway           String
  transactionId     String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  startDate         DateTime
  endDate           DateTime
  totalDays         Int
  dailyRate         Decimal             @db.Decimal(10, 2)
  bookingReference  String              @unique

  userSocialEvent UserSocialEvent @relation(fields: [userSocialEventId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor          VendorProfile   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  servicePackage  ServicePackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  bookingAddOns   BookingAddOn[]
  disputes        Dispute[]

  depositAmount         Decimal?  @db.Decimal(10, 2)
  remainingAmount      Decimal?  @db.Decimal(10, 2)
  depositTxId          String?
  remainingTxId        String?
  depositPaidAt        DateTime?
  remainingPaidAt      DateTime?
  amountReleasedAt     DateTime?
  customerConfirmed    Boolean   @default(false)
  vendorMarkedComplete Boolean   @default(false)
  refundEligible       Boolean   @default(true)

  cancelledBy         String?
  cancellationReason  String?
  cancelledAt         DateTime?

  paymentTransactions PaymentTransaction[]
  refunds             Refund[]
  vendorPaymentStatus VendorPaymentStatus @default(PENDING)
  payouts            Payout[]
  ratings Rating[] @relation("bookingRatings")
}

model BookingAddOn {
  id              String  @id @default(cuid())
  vendorBookingId String
  addOnId         String
  priceAtBooking  Decimal @db.Decimal(10, 2)

  vendorBooking VendorBooking @relation(fields: [vendorBookingId], references: [id], onDelete: Cascade)
  packageAddOn  PackageAddOn  @relation(fields: [addOnId], references: [id], onDelete: Cascade)
}

// ==========================================
// 5. PLATFORM ADMINISTRATION & DISPUTES
// ==========================================

model Dispute {
  id            String   @id @default(cuid())
  bookingId     String
  userId        String
  vendorId      String
  reason        String
  status        String   @default("OPEN")
  adminDecision String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vendorBooking VendorBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentTransaction {
  id                   String  @id @default(cuid())
  transactionId        String  @unique
  gatewayTransactionId String? @unique

  amount        Decimal @db.Decimal(10, 2)
  amountInPaisa Int
  khaltiFee     Decimal @db.Decimal(10, 2) @default(0)

  gateway     PaymentGateway
  paymentType PaymentType

  ticketBookingId String?
  vendorBookingId String?

  status          String @default("PENDING")
  gatewayResponse Json?

  pidx        String?
  productCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketBooking TicketBooking? @relation(fields: [ticketBookingId], references: [id])
  vendorBooking VendorBooking? @relation(fields: [vendorBookingId], references: [id])
  refunds       Refund[]
}

model Refund {
  id                    String  @id @default(cuid())
  originalTransactionId String
  refundAmount          Decimal @db.Decimal(10, 2)
  refundReason          String
  refundStatus         RefundStatus @default(PENDING_ADMIN)
  gatewayRefundId       String?
  gatewayResponse       Json?

  ticketBookingId      String?
  vendorBookingId      String?
  paymentTransactionId String

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  ticketBooking      TicketBooking?     @relation(fields: [ticketBookingId], references: [id])
  vendorBooking      VendorBooking?     @relation(fields: [vendorBookingId], references: [id])
  paymentTransaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])
}

// ==========================================
// 6. PAYOUT & ESCROW MANAGEMENT
// ==========================================

model Payout {
  id              String   @id @default(cuid())
  bookingId       String?  
  ticketBookingId String?  
  vendorId        String
  amount          Decimal  @db.Decimal(10, 2)
  platformCommission Decimal @db.Decimal(10, 2) @default(0)
  vendorPayout    Decimal  @db.Decimal(10, 2) @default(0)
  type            String
  status          String   @default("PENDING")
  adminId         String?
  transactionId   String?  @unique
  khaltiPayoutId  String?
  processedAt     DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bulkPayoutId    String?   
  parentPayout    Payout?   @relation("PayoutBulkRelation", fields: [bulkPayoutId], references: [id], onDelete: SetNull)
  childPayouts    Payout[]  @relation("PayoutBulkRelation")

  vendorBooking VendorBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  ticketBooking TicketBooking? @relation(fields: [ticketBookingId], references: [id], onDelete: SetNull)
  vendor        VendorProfile   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  admin         User?           @relation("AdminPayouts", fields: [adminId], references: [id])

  @@index([bookingId])
  @@index([ticketBookingId])
  @@index([vendorId])
  @@index([status])
  @@index([bulkPayoutId])
}

model VendorUnavailableDate {
  id          String   @id @default(cuid())
  vendorId    String
  date        DateTime
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, date])
}

// ==========================================
// 7. RATINGS & REVIEWS
// ==========================================

model Rating {
  id          String     @id @default(cuid())
  rating      Int
  review      String?
  type        RatingType

  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  vendorId    String?
  vendor      VendorProfile? @relation("vendorRatings", fields: [vendorId], references: [id], onDelete: Cascade)

  eventId     String?
  event       TicketedEvent? @relation("eventRatings", fields: [eventId], references: [id], onDelete: Cascade)

  vendorBookingId String?
  vendorBooking   VendorBooking? @relation("bookingRatings", fields: [vendorBookingId], references: [id], onDelete: SetNull)

  ticketBookingId String?
  ticketBooking   TicketBooking? @relation("ticketRatings", fields: [ticketBookingId], references: [id], onDelete: SetNull)

  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, vendorId, vendorBookingId])
  @@unique([userId, eventId, ticketBookingId])
  @@index([vendorId])
  @@index([eventId])
  @@index([userId])
}

// ==========================================
// 8. PLATFORM SETTINGS
// ==========================================

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String   @default("string")
  group       String   @default("general")
  label       String?
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group])
}