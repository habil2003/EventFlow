import { PrismaClient } from '@prisma/client'

const prisma = new PrismaClient()

async function main() {
  // Step 1: Create a user
  const user = await prisma.user.create({
    data: {
      email: "organizer@eventflow.com",
      name: "Event Organizer",
      password_hash: "temporary-hash",
      role: "ORGANIZER"
    }
  })
  
  console.log("✅ User created:", user.email)
  console.log("User ID:", user.id)
  
  // Step 2: Create an event using that user's ID
  const event = await prisma.event.create({
    data: {
      title: "Tech Conference 2026",
      description: "Learn about new technologies",
      event_date: new Date("2026-06-15"),
      event_time: "14:00",
      location: "Pokhara, Nepal",
      price: 15.99,
      capacity: 100,
      organizer_id: user.id  // Now this matches a real user!
    }
  })
  
  console.log("✅ Event created:", event.title)
}

main()
  .catch(console.error)
  .finally(() => prisma.$disconnect())